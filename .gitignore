results/nb03_angular_spectrum_reference_z1_corr0.4*.npz
results/nb03_angular_spectrum_reference_z1_corr0.5*.npz
results/nb03_angular_spectrum_reference_z1_*_verif.npz
results/nb03_modal_pinn_siren_*scaled*.npz
