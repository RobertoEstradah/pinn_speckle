@misc{zhang2026pepinn,
  author = {Zhang, Huiwen and Ye, Feng and Ma, Chu},
  title  = {Physics-Informed Neural Networks with Architectural Physics Embedding for Large-Scale Wave Field Reconstruction},
  year   = {2026},
  eprint = {2603.02231},
  archivePrefix = {arXiv},
  note   = {PE-PINN: envelope-transformation layers (oscillatory kernel x learnable smooth envelope) with sine (SIREN-style) activation for derivative computation; material-aware domain decomposition across heterogeneous dielectric regions (relative permittivity kappa = 1 to 80). Reports MSE vs. COMSOL of 3.38e-3 (2D free space), 7.94e-3 (2D diffraction), 7.12e-3 (2D refraction); >10x faster convergence than vanilla PINN, orders-of-magnitude lower memory than FEM}
}

