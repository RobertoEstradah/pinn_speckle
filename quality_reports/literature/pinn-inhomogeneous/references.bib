@article{kim2026hno,
  author  = {Kim, Ju O and Lee, Deokwoo},
  title   = {{FFT}-Free Neural Operators for {H}elmholtz Scattering via Adaptive Coefficient Modulation},
  journal = {Applied Sciences},
  volume  = {16},
  number  = {12},
  pages   = {5997},
  year    = {2026},
  doi     = {10.3390/app16125997},
  note    = {Published 13 June 2026. Helmholtz Neural Operator (HNO): FFT-free branch-trunk operator (DeepONet family) with a hybrid three-layer SIREN (omega0=30) + 16 learnable-Fourier-frequency trunk (K=64 total basis outputs) and a rank-32 hypernetwork branch with bounded multiplicative gating; targets high-contrast inhomogeneous-medium Helmholtz scattering, addressing FNO "mode saturation" at high refractive-index contrast (reported 15:1 test case). Data-driven operator training (labeled simulation pairs), NOT a physics-residual PINN loss}
